// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model User {
  id         Int       @id @default(autoincrement())
  nama_institusi   String
  email_perusahaan String @unique
  telpn_perusahaan String
  password         String
  alamat           String
  posisi           String

  // Relasi
  peserta          Peserta[]

  
}

model Peserta {
  id          Int       @id @default(autoincrement())
  nama_peserta String
  email_peserta String
  telpn_peserta Int
  alamat_peserta        String

  id_user Int?
  user    User?    @relation(fields: [id_user], references: [id], onDelete: SetNull)

  // Relasi ke bidang dan pelatihan
  bidang     Bidang[]
  pelatihan  Pelatihan[]
  
  pesertaSertifikat PesertaSertifikat[]

 
}

model Bidang {
  id             Int       @id @default(autoincrement())
  nama_bidang    String
  daftar_pelatihan String?
  id_peserta     Int?

  peserta  Peserta?  @relation(fields: [id_peserta], references: [id], onDelete: SetNull)
  pelatihan Pelatihan[]

 
}

model Pelatihan {
  id            Int       @id @default(autoincrement())
  biaya         Int
  jangka_waktu  DateTime
  nama_bidang   String

  id_peserta Int?
  id_Bidang  Int?

  peserta Peserta? @relation(fields: [id_peserta], references: [id], onDelete: SetNull)
  bidang  Bidang?  @relation(fields: [id_Bidang], references: [id], onDelete: SetNull)
  sertifikasi Sertifikasi[]

 
}

model Sertifikasi {
  id             Int       @id @default(autoincrement())
  Nama_dokumen   String
  tanggal_dan_bulan DateTime
 
  id_pelatihan   Int


  pelatihan Pelatihan @relation(fields: [id_pelatihan], references: [id])
  pesertaSertifikat PesertaSertifikat[]

  
}

model PesertaSertifikat {
  id                Int           @id @default(autoincrement())
  id_peserta        Int
  id_sertifikat     Int?

  peserta           Peserta       @relation(fields: [id_peserta], references: [id], onDelete: Cascade)
  sertifikat        Sertifikasi?  @relation(fields: [id_sertifikat], references: [id], onDelete: SetNull)

  
}