// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model User {
  id                Int        @id @default(autoincrement())
  nama_institusi    String
  email_perusahaan  String     @unique
  telpn_perusahaan  String       
  password          String
  alamat            String
  posisi            String
  bukti_pembayaran  String?

  peserta           Peserta[]
}

model Peserta {
  id              Int       @id @default(autoincrement())
  nama_peserta      String
  email_peserta     String
  telpn_peserta     String
  alamat_peserta    String
  bukti_pembayaran  String?
  status_pembayaran String?

  // Relasi ke User
  id_user         Int?
  user            User?     @relation(fields: [id_user], references: [id], onDelete: SetNull)

  // Relasi ke Bidang
  id_bidang       Int?
  bidang          Bidang?   @relation(fields: [id_bidang], references: [id], onDelete: SetNull)

  // Relasi ke Pelatihan (1 peserta = 1 pelatihan)
  id_pelatihan    Int?
  pelatihan       Pelatihan? @relation(fields: [id_pelatihan], references: [id], onDelete: SetNull)

  // Sertifikat (via tabel penghubung)
  pesertaSertifikat PesertaSertifikat[]
}

model Bidang {
  id               Int          @id @default(autoincrement())
  nama_bidang      String
  // daftar_pelatihan String? //udah 

  peserta          Peserta[]
  pelatihan        Pelatihan[]
}

model Pelatihan {
  id             Int          @id @default(autoincrement())
  // biaya          Int
  biaya            Decimal @db.Decimal(20, 2)
  jangka_waktu   String 
  nama_pelatihan String

  id_bidang      Int?
  bidang         Bidang?      @relation(fields: [id_bidang], references: [id], onDelete: SetNull)

  peserta        Peserta[]
  sertifikasi    Sertifikasi[]
}

model Sertifikasi {
  id                 Int                 @id @default(autoincrement())
  nama_dokumen       String
  tanggal_dan_bulan  DateTime

  id_pelatihan       Int
  pelatihan          Pelatihan          @relation(fields: [id_pelatihan], references: [id])

  pesertaSertifikat  PesertaSertifikat[]
}

model PesertaSertifikat {
  id              Int           @id @default(autoincrement())
  id_peserta      Int
  id_sertifikat   Int?

  peserta         Peserta       @relation(fields: [id_peserta], references: [id], onDelete: Cascade)
  sertifikat      Sertifikasi?  @relation(fields: [id_sertifikat], references: [id], onDelete: SetNull)
}
